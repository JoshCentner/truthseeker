{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vitest/globals", "vite/client"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "ui/**/*.ts", "src-pipeline/**/*.ts", "dashboard/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
